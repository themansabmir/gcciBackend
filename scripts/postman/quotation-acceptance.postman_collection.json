{
  "info": {
    "name": "Quotation Acceptance Flow",
    "_postman_id": "a2f6c8d4-0000-0000-0000-000000000000",
    "description": "Collection to validate quotation -> acceptance -> auto-creation of shipment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Get Ports",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/port"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "if (Array.isArray(res) && res.length > 0) {",
              "  pm.environment.set('portId', res[0]._id);",
              "  console.log('Saved portId', res[0]._id);",
              "} else if (res.data && res.data.length > 0) {",
              "  pm.environment.set('portId', res.data[0]._id);",
              "  console.log('Saved portId', res.data[0]._id);",
              "} else {",
              "  console.warn('No ports found in response');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "1 - Create Vendor (Customer)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/vendor",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vendor_name\": \"Test Customer\",\n  \"vendor_type\": [\"shipper\"],\n  \"credit_days\": \"30\",\n  \"pan_number\": \"ABCDE1234F\",\n  \"primary_email\": \"test-customer@example.com\",\n  \"primary_mobile_number\": \"9123456789\",\n  \"locations\": [\n    {\n      \"city\": \"Mumbai\",\n      \"address\": \"123 Test St\",\n      \"state\": \"MH\",\n      \"country\": \"IN\",\n      \"pin_code\": \"400001\",\n      \"telephone\": \"02212345678\",\n      \"mobile_number\": \"9123456789\",\n      \"email\": \"branch@testexample.com\",\n      \"gst_number\": \"27ABCDE1234F1Z5\"\n    }\n  ]\n}"
        }
      ,
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "const id = res?._id || res?.data?._id;",
              "if (id) { pm.environment.set('vendorId', id); console.log('Saved vendorId', id); } else { console.warn('Could not find vendor id in response'); }"
            ]
          }
        }
      ]
      }
    },
    {
      "name": "2 - Create Quotation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/quotation",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{vendorId}}\",\n  \"shippingLineId\": \"{{vendorId}}\",\n  \"startPortId\": \"{{portId}}\",\n  \"endPortId\": \"{{portId}}\",\n  \"containerType\": \"FCL\",\n  \"containerSize\": \"20\",\n  \"tradeType\": \"IMPORT\",\n  \"validFrom\": \"2026-01-09T00:00:00.000Z\",\n  \"validTo\": \"2026-02-08T00:00:00.000Z\",\n  \"lineItems\": [\n    { \"chargeName\": \"Freight\", \"hsnCode\": \"9985\", \"price\": 100, \"currency\": \"INR\", \"quantity\": 1 }\n  ]\n}\n\n# Notes:\n# - Replace REPLACE_WITH_PORT_ID with an existing Port ID from GET {{baseUrl}}/port\n# - Ensure customerId is set to the exact _id returned from creating vendor\n# - Values shown are valid formats for server-side validation" 
        }
      ,
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "const id = res?._id || res?.data?._id;",
              "if (id) { pm.environment.set('quotationId', id); console.log('Saved quotationId', id); } else { console.warn('Could not find quotation id in response'); }"
            ]
          }
        }
      ]
      }
    },
    {
      "name": "3 - Send Quotation (mark SENT)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/quotation/{{quotationId}}/send"
      }
    },
    {
      "name": "4 - Accept Quotation (mark ACCEPTED)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/quotation/{{quotationId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{ \"status\": \"ACCEPTED\" }"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "const shipmentId = res?.shipmentId || res?.data?.shipmentId;",
              "if (shipmentId) {",
              "  pm.environment.set('shipmentId', shipmentId);",
              "  console.log('Saved shipmentId from status response', shipmentId);",
              "} else {",
              "  // Fallback: fetch quotation by id to extract shipmentId",
              "  pm.sendRequest({ url: '{{baseUrl}}/quotation?_id={{quotationId}}', method: 'GET' }, function (err, r) {",
              "    try {",
              "      const body = r.json();",
              "      const q = Array.isArray(body) ? body[0] : body;",
              "      const sId = q?.shipmentId || q?.data?.shipmentId;",
              "      if (sId) { pm.environment.set('shipmentId', sId); console.log('Saved shipmentId from fallback', sId); } else { console.warn('No shipmentId found in fallback GET /quotation'); }",
              "    } catch (e) {",
              "      console.warn('Fallback fetch failed', e);",
              "    }",
              "  });",
              "}"
            ]
          }
        }
      ]
    },

    {
      "name": "5 - Get Quotation (inspect shipmentId)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/quotation/{{quotationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "const shipmentId = res?.shipmentId || res?.data?.shipmentId;",
              "if (shipmentId) {",
              "  pm.environment.set('shipmentId', shipmentId);",
              "  console.log('Saved shipmentId', shipmentId);",
              "} else {",
              "  console.warn('No shipmentId found in quotation response');",
              "}"
            ]
          }
        }
      ]
    }
    ,
    {
      "name": "5.1 - Login (Get Token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{ \"email\": \"{{authEmail}}\", \"password\": \"{{authPassword}}\" }"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "const token = res?.access_token || res?.data?.access_token;",
              "if (token) {",
              "  pm.environment.set('authToken', token);",
              "  console.log('Saved authToken');",
              "} else {",
              "  console.warn('No access_token in login response');",
              "}"
            ]
          }
        }
      ]
    }
    ,
    {
      "name": "6 - Get MBL by ShipmentId",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": "{{baseUrl}}/mbl/{{shipmentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "if (res && (res._id || res.data?._id)) {",
              "  const id = res._id || res.data._id;",
              "  pm.environment.set('mblId', id);",
              "  console.log('Saved mblId', id);",
              "} else {",
              "  console.warn('MBL not found for shipmentId', pm.environment.get('shipmentId'));",
              "}"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "vendorId", "value": "REPLACE_WITH_VENDOR_ID" },
    { "key": "portId", "value": "REPLACE_WITH_PORT_ID" },
    { "key": "quotationId", "value": "REPLACE_WITH_QUOTATION_ID" },
    { "key": "shipmentId", "value": "REPLACE_WITH_SHIPMENT_ID" },
    { "key": "mblId", "value": "REPLACE_WITH_MBL_ID" },
    { "key": "authEmail", "value": "seed-admin@example.com" },
    { "key": "authPassword", "value": "123456789" },
    { "key": "authToken", "value": "" }
  ]
}